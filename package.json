{
  "name": "aws-s3-lock-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wait on, acquire, and clean-up S3-based locks",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/acquire.js --out dist/acquire --minify && ncc build lib/release.js --out dist/release --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/aws-s3-lock-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/lib-storage": "^3.1154.0",
    "ansi-styles": "^7.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.3",
    "@freckle/prettier-config": "^1.3.3",
    "@freckle/tsconfig": "^1.3.3",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "prettier": "@freckle/prettier-config"
}
