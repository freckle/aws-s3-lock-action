{
  "name": "aws-s3-lock-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wait on, acquire, and clean-up S3-based locks",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/acquire.js --out dist/acquire --minify && ncc build lib/release.js --out dist/release --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/aws-s3-lock-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1144.0",
    "ansi-styles": "^7.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.2.0",
    "@freckle/prettier-config": "^1.2.0",
    "@freckle/tsconfig": "^1.2.0",
    "@types/node": "^24.19.0",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "prettier": "@freckle/prettier-config"
}
