{
  "name": "aws-s3-lock-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wait on, acquire, and clean-up S3-based locks",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/acquire.js --out dist/acquire --minify && ncc build lib/release.js --out dist/release --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/aws-s3-lock-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "ansi-styles": "^7.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@freckle/eslint-config": "^1.3.5",
    "@freckle/prettier-config": "^1.3.5",
    "@freckle/tsconfig": "^1.3.5",
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "prettier": "@freckle/prettier-config"
}
