{
  "name": "aws-s3-lock-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wait on, acquire, and clean-up S3-based locks",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/acquire.js --out dist/acquire --minify && ncc build lib/release.js --out dist/release --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "readme": "npx action-docs -u && prettier --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/aws-s3-lock-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/lib-storage": "^3.1138.0",
    "ansi-styles": "^7.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
